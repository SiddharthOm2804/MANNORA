# Local API settings
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/neural_city
CLIENT_URL=http://localhost:5173
COOKIE_SAME_SITE=lax
# Optional comma-separated allowlist; overrides CLIENT_URL
# CORS_ORIGINS=http://localhost:5173,https://app.example.org
# Set only behind one trusted reverse proxy
TRUST_PROXY=false

# Optional services (server-side only)
# REDIS_URL=redis://127.0.0.1:6379
AI_PROVIDER=fallback
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Public client API URL for hosted builds only. Never put credentials here.
# VITE_API_URL=https://api.example.org/api
